{
	"name": "invoice-generator",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0",
		"bun": ">=1.2.0"
	},
	"scripts": {
		"dev": "vite dev --open --host",
		"sync-ds": "dropout-ds-sync --apply .",
		"build": "vite build",
		"preview": "bun run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ds": "node --test src/lib/ds/button-contract.test.js src/lib/ds/input-contract.test.js",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"db:check": "drizzle-kit check",
		"db:migrate": "wrangler d1 migrations apply invoice_generator --remote",
		"db:migrate:local": "wrangler d1 migrations apply invoice_generator --local",
		"db:migrate:list": "wrangler d1 migrations list invoice_generator --local",
		"seed": "wrangler d1 execute invoice_generator --local --file ./seed/seed.sql"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261106.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"drizzle-kit": "0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "4.0.1",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.7.16",
		"better-auth": "^1.7.16",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3",
		"gsap": "^3.15.0",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1",
		"svelte-sonner": "^1.2.3",
		"vaul-svelte": "^0.3.2",
		"zod": "^4.6.7"
	}
}
