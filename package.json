{
	"name": "invoice-generator",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0",
		"bun": ">=1.2.0"
	},
	"scripts": {
		"dev": "vite dev --open --host",
		"sync-ds": "rsync -a --delete ../../dropout-design-system/src/lib/ ./src/lib/ds/",
		"build": "vite build",
		"preview": "bun run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ds": "node --test src/lib/ds/button-contract.test.js src/lib/ds/input-contract.test.js",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"db:check": "drizzle-kit check",
		"db:migrate": "wrangler d1 migrations apply invoice_generator --remote",
		"db:migrate:local": "wrangler d1 migrations apply invoice_generator --local",
		"db:migrate:list": "wrangler d1 migrations list invoice_generator --local",
		"seed": "wrangler d1 execute invoice_generator --local --file ./seed/seed.sql"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260813.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "0.31.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"wrangler": "^4.156.1"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.7.15",
		"better-auth": "^1.7.15",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"gsap": "^3.15.0",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1",
		"svelte-sonner": "^1.1.1",
		"vaul-svelte": "^0.3.2",
		"zod": "^4.6.6"
	}
}
